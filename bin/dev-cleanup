#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"

BOLD='\033[1m'
RED='\033[0;31m'
RESET='\033[0m'

# Resolve the real location of this script so symlinked installs find the sibling tools
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR=$(cd "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
TOOL_DIR=$(cd "$(dirname "$SOURCE")" && pwd)

usage() {
  printf 'Usage: dev-cleanup <command> [args...]\n\n'
  printf 'Analyze and clean dev build artifacts and caches.\n\n'
  printf 'Commands:\n'
  printf '  sizes [<dir>]   Analyze artifact disk usage (read-only)\n'
  printf '  clean [args]    List/remove build artifacts (dry-run by default)\n'
  printf '  cache           Clean package manager and tool caches\n'
  printf '  all [<dir>]     sizes, then clean --delete (safe mode), then cache\n'
  printf '  help <command>  Show help for a command\n\n'
  printf 'Options:\n'
  printf '  --help, -h      Show this help\n'
  printf '  --version, -V   Show version\n'
  exit "${1:-1}"
}

require_tool() {
  [[ -x "$TOOL_DIR/$1" ]] && return 0
  printf '%bError:%b %s not found next to dev-cleanup (%s)\n' "$RED" "$RESET" "$1" "$TOOL_DIR" >&2
  exit 1
}

run_all() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      -*)
        printf '%bError:%b "all" accepts only a directory, no flags (%s).\n' "$RED" "$RESET" "$arg" >&2
        printf 'For rm -rf use "dev-cleanup clean --delete --fast" explicitly.\n' >&2
        exit 1 ;;
    esac
  done
  if [[ $# -gt 1 ]]; then
    printf '%bError:%b "all" accepts at most one directory.\n' "$RED" "$RESET" >&2
    exit 1
  fi
  require_tool dev-sizes
  require_tool dev-clean
  require_tool dev-cache-clean

  printf '%b[1/3] Analyzing artifact sizes...%b\n' "$BOLD" "$RESET"
  "$TOOL_DIR/dev-sizes" "$@" \
    || { printf '%bStep 1/3 (sizes) failed.%b\n' "$RED" "$RESET" >&2; exit 1; }

  printf '\n%b[2/3] Removing build artifacts (safe mode)...%b\n' "$BOLD" "$RESET"
  "$TOOL_DIR/dev-clean" --delete "$@" \
    || { printf '%bStep 2/3 (clean) failed.%b\n' "$RED" "$RESET" >&2; exit 1; }

  printf '\n%b[3/3] Cleaning caches...%b\n' "$BOLD" "$RESET"
  "$TOOL_DIR/dev-cache-clean" \
    || { printf '%bStep 3/3 (cache) failed.%b\n' "$RED" "$RESET" >&2; exit 1; }
}

[[ $# -eq 0 ]] && usage

cmd="$1"
shift

case "$cmd" in
  sizes)        require_tool dev-sizes;       exec "$TOOL_DIR/dev-sizes" "$@" ;;
  clean)        require_tool dev-clean;       exec "$TOOL_DIR/dev-clean" "$@" ;;
  cache)        require_tool dev-cache-clean; exec "$TOOL_DIR/dev-cache-clean" "$@" ;;
  all)          run_all "$@" ;;
  help)
    [[ $# -eq 1 ]] || usage
    case "$1" in
      sizes) require_tool dev-sizes;       exec "$TOOL_DIR/dev-sizes" --help ;;
      clean) require_tool dev-clean;       exec "$TOOL_DIR/dev-clean" --help ;;
      cache) require_tool dev-cache-clean; exec "$TOOL_DIR/dev-cache-clean" --help ;;
      all)   printf 'Usage: dev-cleanup all [<dir>]\n'
             printf 'Runs sizes, then clean --delete (safe mode, with confirmation), then cache.\n'
             exit 0 ;;
      *)     printf 'Unknown command: %s\n' "$1"; usage ;;
    esac ;;
  --help|-h)    usage 0 ;;
  --version|-V) printf 'dev-cleanup %s\n' "$VERSION"; exit 0 ;;
  *)            printf 'Unknown command: %s\n' "$cmd"; usage ;;
esac
