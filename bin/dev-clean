#!/usr/bin/env bash
set -euo pipefail

TARGETS=()
DRY_RUN=true
DELETE_MODE="safe"
MODE_FLAG_SET=false
ASSUME_YES=false

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
DIM='\033[2m'
RESET='\033[0m'

format_size() {
  LC_NUMERIC=C awk -v kb="$1" 'BEGIN {
    if (kb >= 1048576) printf "%.1fG\n", kb/1048576
    else if (kb >= 1024) printf "%.1fM\n", kb/1024
    else printf "%dK\n", kb
  }'
}

usage() {
  printf 'Usage: dev-clean [--delete [--safe|--fast] [--yes]] [<directory>...]\n'
  printf 'Lists and removes build artifacts. Dry-run unless --delete is given.\n'
  printf '  <directory>  Directories to clean (default: ~/dev)\n'
  printf '  --delete     Actually delete (default: dry-run)\n'
  printf '  --safe       Use trash, recoverable (default with --delete)\n'
  printf '  --fast       Use rm -rf (with warning, not recoverable)\n'
  printf '  --yes, -y    Answer confirmations with yes (not with --fast)\n'
  printf '  --help, -h   Show this help\n'
  exit "${1:-1}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --delete)  DRY_RUN=false ;;
    --safe)    DELETE_MODE="safe"; MODE_FLAG_SET=true ;;
    --fast)    DELETE_MODE="fast"; MODE_FLAG_SET=true ;;
    --yes|-y)  ASSUME_YES=true ;;
    --help|-h) usage 0 ;;
    -*)        printf 'Unknown flag: %s\n' "$1"; usage ;;
    *)         TARGETS+=("$1") ;;
  esac
  shift
done

[[ ${#TARGETS[@]} -gt 0 ]] || TARGETS=("$HOME/dev")

if [[ "$ASSUME_YES" == "true" && "$DELETE_MODE" == "fast" ]]; then
  printf '%bError:%b --yes cannot be combined with --fast (rm -rf always asks).\n' "$RED" "$RESET"
  exit 1
fi

# Asks a yes/no question; --yes answers it, EOF on stdin counts as no
confirm() {
  local answer=""
  [[ "$ASSUME_YES" == "true" ]] && return 0
  read -r -p "$1 [y/N] " answer || true
  [[ "$answer" =~ ^[Yy]$ ]]
}

# Every target is validated before anything is scanned
for i in "${!TARGETS[@]}"; do
  t="${TARGETS[$i]}"
  [[ "$t" != "/" ]] && t="${t%/}"
  [[ -d "$t" ]] || { printf 'Directory not found: %s\n' "$t"; exit 1; }
  t=$(cd "$t" && pwd)
  if [[ "$t" == "/" || "$t" == "$HOME" ]]; then
    printf '%bError:%b %s is not allowed as a target.\n' "$RED" "$RESET" "$t"
    exit 1
  fi
  if [[ "$t" != "$HOME"/* && "$DRY_RUN" == "false" ]]; then
    printf '%bWarning:%b target is outside %s: %s\n' "$YELLOW" "$RESET" "$HOME" "$t"
    confirm "Continue anyway?" || { echo "Aborted."; exit 0; }
  fi
  TARGETS[i]="$t"
done

if [[ "$DRY_RUN" == "true" && "$MODE_FLAG_SET" == "true" ]]; then
  printf '%bNote:%b --safe/--fast only take effect together with --delete (currently dry-run).\n' "$YELLOW" "$RESET"
fi

if [[ "$DRY_RUN" == "false" && "$DELETE_MODE" == "safe" ]] && ! command -v trash &>/dev/null; then
  printf '%bError:%b trash is not installed (macOS: brew install trash, Linux: trash-cli) — or use --fast.\n' "$RED" "$RESET"
  exit 1
fi

# Returns 0 if the directory name is ignored by git (project .gitignore, global core.excludesFile, or .git/info/exclude)
is_gitignored() {
  local dir="$1"
  git -C "$(dirname "$dir")" rev-parse --git-dir &>/dev/null || return 1
  git -C "$(dirname "$dir")" check-ignore -q "$(basename "$dir")" 2>/dev/null
}

# Returns 0 if a stack-specific marker file identifies the directory as a build artifact
has_marker() {
  local dir="$1" name parent
  name=$(basename "$dir")
  parent=$(dirname "$dir")
  case "$name" in
    vendor)      [[ -f "$parent/composer.json" || -f "$parent/go.mod" || -f "$parent/Gemfile" ]] ;;
    deps|_build) [[ -f "$parent/mix.exs" ]] ;;
    venv)        [[ -f "$dir/pyvenv.cfg" ]] ;;
    target)      [[ -f "$parent/Cargo.toml" || -f "$parent/pom.xml" ]] ;;
    obj)         compgen -G "$parent/*.csproj" >/dev/null || compgen -G "$parent/*.fsproj" >/dev/null ;;
    .build)      [[ -f "$parent/Package.swift" ]] ;;
    *)           return 1 ;;
  esac
}

# Replaces non-printable characters so directory names cannot inject terminal escapes
display_path() {
  printf '%s' "${1//[![:print:]]/?}"
}

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
data_file="$tmpdir/data"
touch "$data_file"

# Always-delete artifacts (unambiguous names)
_n=0
printf 'Scanning %s...' "${TARGETS[*]}" >&2
(find "${TARGETS[@]}" -type d \( \
    -name "node_modules"     -o -name ".next"          -o -name ".nuxt"         \
    -o -name ".output"       -o -name ".nitro"         -o -name ".turbo"        \
    -o -name ".cache"        -o -name "coverage"                                \
    -o -name ".dart_tool"    -o -name ".gradle"                                 \
    -o -name "Pods"          -o -name ".symlinks"                               \
    -o -name ".venv"         -o -name "__pycache__"                             \
    -o -name ".pytest_cache" -o -name ".mypy_cache"    -o -name ".ruff_cache"   \
    -o -name ".tox"                                                              \
    -o -name ".svelte-kit"   -o -name ".astro"         -o -name ".parcel-cache" \
    -o -name ".angular"      -o -name ".terraform"                              \
    -o -name ".stack-work"   -o -name "dist-newstyle"                           \
  \) -prune -print0 2>/dev/null || true) \
| while IFS= read -r -d '' dir; do
    # Paths with control characters would corrupt the tab/newline-separated data file
    case "$dir" in
      *$'\n'*|*$'\t'*)
        printf '\r\033[K%bSkipped (control characters in path):%b %q\n' "$YELLOW" "$RESET" "$dir" >&2
        continue ;;
    esac
    kb=$(du -sk "$dir" 2>/dev/null | awk '{print $1}')
    [[ -n "$kb" ]] || kb=0
    printf '%s\tdelete\t%s\n' "$kb" "$dir"
    _n=$((_n + 1))
    printf '\rScanning %s... (%d found)' "${TARGETS[*]}" "$_n" >&2
  done >> "$data_file"
printf '\r\033[K' >&2

# Conditional artifacts (generic names): deleted only if a stack marker matches OR the dir is gitignored
_n=0
printf 'Checking conditional directories...' >&2
(find "${TARGETS[@]}" -type d \( \
    -name "node_modules"     -o -name ".next"          -o -name ".nuxt"         \
    -o -name ".output"       -o -name ".nitro"         -o -name ".turbo"        \
    -o -name ".cache"        -o -name "coverage"                                \
    -o -name ".dart_tool"    -o -name ".gradle"                                 \
    -o -name "Pods"          -o -name ".symlinks"                               \
    -o -name ".venv"         -o -name "__pycache__"                             \
    -o -name ".pytest_cache" -o -name ".mypy_cache"    -o -name ".ruff_cache"   \
    -o -name ".tox"                                                              \
    -o -name ".svelte-kit"   -o -name ".astro"         -o -name ".parcel-cache" \
    -o -name ".angular"      -o -name ".terraform"                              \
    -o -name ".stack-work"   -o -name "dist-newstyle"                           \
  \) -prune -o -type d \( \
       -name "dist"    -o -name "build"  -o -name "out"                         \
    -o -name "vendor"  -o -name "deps"   -o -name "obj"                         \
    -o -name "venv"    -o -name "target"                                        \
    -o -name ".build"  -o -name "_build"                                        \
  \) -prune -print0 2>/dev/null || true) \
| while IFS= read -r -d '' dir; do
    case "$dir" in
      *$'\n'*|*$'\t'*)
        printf '\r\033[K%bSkipped (control characters in path):%b %q\n' "$YELLOW" "$RESET" "$dir" >&2
        continue ;;
    esac
    kb=$(du -sk "$dir" 2>/dev/null | awk '{print $1}')
    [[ -n "$kb" ]] || kb=0
    if has_marker "$dir" || is_gitignored "$dir"; then
      printf '%s\tdelete\t%s\n' "$kb" "$dir"
    else
      printf '%s\tskip\t%s\n' "$kb" "$dir"
    fi
    _n=$((_n + 1))
    printf '\rChecking conditional directories... (%d checked)' "$_n" >&2
  done >> "$data_file"
printf '\r\033[K' >&2

# Overlapping targets find the same directory twice; keep the first entry per path
awk -F'\t' '!seen[$3]++' "$data_file" > "$tmpdir/data_unique"
data_file="$tmpdir/data_unique"

total_kb=$(awk -F'\t' '$2=="delete"{s+=$1} END{print s+0}' "$data_file")
total_count=$(awk -F'\t' '$2=="delete"{c++} END{print c+0}' "$data_file")
total_skip=$(awk -F'\t' '$2=="skip"{c++} END{print c+0}' "$data_file")

# The same summary line is printed with or without findings, so callers can parse it
[[ "$total_count" -eq 0 && "$total_skip" -eq 0 ]] && list_end='.' || list_end=$':\n'
if [[ "$DRY_RUN" == "true" ]]; then
  printf '\n%b[DRY RUN]%b Found %d artifact directories (%s)%s\n' \
    "$BOLD" "$RESET" "$total_count" "$(format_size "$total_kb")" "$list_end"
else
  printf '\nFound %d artifact directories (%s)%s\n' \
    "$total_count" "$(format_size "$total_kb")" "$list_end"
fi

awk -F'\t' '$2=="delete"' "$data_file" | sort -rn | while IFS=$'\t' read -r kb _ dir; do
  printf '  %6s  %s\n' "$(format_size "$kb")" "$(display_path "$dir")"
done

awk -F'\t' '$2=="skip"' "$data_file" | sort -rn | while IFS=$'\t' read -r kb _ dir; do
  printf '  %6s  %b[skipped — no marker, not gitignored]%b  %s\n' \
    "$(format_size "$kb")" "$DIM" "$RESET" "$(display_path "$dir")"
done

printf '\nTotal reclaimable: %s\n' "$(format_size "$total_kb")"

if [[ "$total_count" -eq 0 && "$total_skip" -eq 0 ]]; then
  printf '%bNo artifacts found.%b\n' "$GREEN" "$RESET"
  [[ "$DRY_RUN" == "true" ]] || printf 'Nothing to delete.\n'
  exit 0
fi

if [[ "$DRY_RUN" == "true" ]]; then
  printf 'Run with --delete to remove.\n'
  exit 0
fi

if [[ "$total_count" -eq 0 ]]; then
  printf 'Nothing to delete.\n'
  exit 0
fi

# Delete mode
if [[ "$DELETE_MODE" == "fast" ]]; then
  printf '\n%b%bWARNING: rm -rf will be used — NOT recoverable!%b\n' \
    "$BOLD" "$RED" "$RESET"
fi

confirm "$(printf 'Delete %d directories?' "$total_count")" || { printf '\nAborted.\n'; exit 0; }

# cut -f3- keeps the full path even if it contains further tab-like field content
awk -F'\t' '$2=="delete"' "$data_file" | cut -f3- > "$tmpdir/to_delete"

deleted=0
failed=0
while IFS= read -r dir; do
  [[ -d "$dir" ]] || continue
  if [[ "$DELETE_MODE" == "fast" ]]; then
    if rm -rf "$dir" 2>/dev/null; then
      deleted=$((deleted + 1))
      printf '\rDeleting... (%d/%d)' "$deleted" "$total_count" >&2
    else
      printf '%bError:%b %s\n' "$RED" "$RESET" "$(display_path "$dir")"
      failed=$((failed + 1))
    fi
  else
    if trash "$dir" 2>/dev/null; then
      deleted=$((deleted + 1))
      printf '\rDeleting... (%d/%d)' "$deleted" "$total_count" >&2
    else
      printf '%bError:%b %s\n' "$RED" "$RESET" "$(display_path "$dir")"
      failed=$((failed + 1))
    fi
  fi
done < "$tmpdir/to_delete"
printf '\r\033[K' >&2

printf '\n%b%d directories deleted%b' "$GREEN" "$deleted" "$RESET"
[[ "$failed" -gt 0 ]] && printf ', %b%d errors%b' "$RED" "$failed" "$RESET"
printf '\n'
