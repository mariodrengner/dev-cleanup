#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: dev-cache-clean\n'
  printf 'Cleans package manager and tool caches (Homebrew, Yarn, npm, pip,\n'
  printf 'Composer, Bun, Docker, Flutter, Xcode DerivedData, iOS simulators).\n'
  printf 'Docker and DerivedData ask for confirmation before deleting.\n'
  printf '  --help, -h  Show this help\n'
  exit "${1:-1}"
}

case "${1:-}" in
  --help|-h) usage 0 ;;
  ?*)        printf 'Unknown argument: %s\n' "$1"; usage ;;
esac

TARGET="$HOME/dev"
BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
RESET='\033[0m'

section() { printf '\n%b── %s ──%b\n' "$BOLD" "$1" "$RESET"; }
ok()      { printf '%b✓%b %s\n' "$GREEN" "$RESET" "$1"; }
skip()    { printf '%b[skipped — not installed]%b %s\n' "$YELLOW" "$RESET" "$1"; }

# 1. Homebrew
section "Homebrew"
if command -v brew &>/dev/null; then
  brew cleanup || true
  ok "brew cleanup done"
else
  skip "brew"
fi

# 2. Yarn
section "Yarn"
if command -v yarn &>/dev/null; then
  yarn cache clean || true
  ok "yarn cache cleaned"
else
  skip "yarn"
fi

# 3. npm
section "npm"
if command -v npm &>/dev/null; then
  npm cache clean --force || true
  ok "npm cache cleaned"
else
  skip "npm"
fi

# 4. pip
section "pip"
if command -v pip3 &>/dev/null; then
  pip3 cache purge || true
  ok "pip cache purged"
elif command -v pip &>/dev/null; then
  pip cache purge || true
  ok "pip cache purged"
else
  skip "pip"
fi

# 5. Composer
section "Composer"
if command -v composer &>/dev/null; then
  composer clear-cache || true
  ok "Composer cache cleared"
else
  skip "composer"
fi

# 6. Bun
section "Bun"
if command -v bun &>/dev/null; then
  bun pm cache rm || true
  ok "bun cache cleaned"
else
  skip "bun"
fi

# 7. Docker
section "Docker"
if command -v docker &>/dev/null && docker info &>/dev/null; then
  docker system df
  printf '\n%b%bWARNING: Deletes ALL unused images, containers, and volumes.%b\n' \
    "$BOLD" "$RED" "$RESET"
  read -r -p "Continue? [y/N] " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    docker system prune -a --volumes --force
    ok "Docker cleaned"
  else
    echo "Skipped."
  fi
else
  skip "docker (not installed or not running)"
fi

# 8. Flutter
section "Flutter"
if command -v flutter &>/dev/null; then
  flutter_dirs=()
  while IFS= read -r -d '' f; do
    flutter_dirs+=("$(dirname "$f")")
  done < <(find "$TARGET" -name "pubspec.yaml" -not -path "*/.*" -print0 2>/dev/null) || true

  total=${#flutter_dirs[@]}
  if [[ "$total" -eq 0 ]]; then
    echo "No Flutter projects found."
  else
    failed_flutter=0
    for i in "${!flutter_dirs[@]}"; do
      dir="${flutter_dirs[$i]}"
      printf '[%d/%d] flutter clean in %s\n' "$((i + 1))" "$total" "$dir"
      (cd "$dir" && flutter clean) || {
        printf '%bError in %s, skipped%b\n' "$RED" "$dir" "$RESET"
        failed_flutter=$((failed_flutter + 1))
      }
    done
    if [[ "$failed_flutter" -eq 0 ]]; then
      ok "Flutter projects cleaned"
    else
      printf '%b%d project(s) failed%b\n' "$RED" "$failed_flutter" "$RESET"
    fi
  fi
else
  skip "flutter"
fi

# 9. Xcode DerivedData
section "Xcode DerivedData"
if command -v xcodebuild &>/dev/null; then
  derived="$HOME/Library/Developer/Xcode/DerivedData"
  if [[ -d "$derived" ]]; then
    size=$(du -sh "$derived" 2>/dev/null | awk '{print $1}') || size="(size unknown)"
    printf 'Size: %s (%s)\n' "$size" "$derived"
    read -r -p "Delete? [y/N] " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      rm -rf "$derived"
      ok "DerivedData deleted"
    else
      echo "Skipped."
    fi
  else
    echo "DerivedData directory not found."
  fi
else
  skip "xcodebuild"
fi

# 10. iOS Simulatoren
section "iOS Simulatoren"
if command -v xcrun &>/dev/null; then
  printf 'This may take a moment...\n'
  xcrun simctl delete unavailable || true
  ok "Unavailable simulators deleted"
else
  skip "xcrun"
fi

printf '\n%b%bDone!%b\n' "$GREEN" "$BOLD" "$RESET"
